{
  "wall": [
    {
      "speaker": "HOOSHANG",
      "text": "Cousin joon!",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "Grab a can. This wall's ours.",
      "face": "joyful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Your moustache is crooked.",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "Art takes risks.",
      "face": "joyful"
    },
    {
      "speaker": "JAMSHID",
      "text": "Your turn. Make it good.",
      "face": "excited"
    },
    {
      "speaker": "HOOSHANG",
      "text": "We should go before dark.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "One last thing. Rumi.",
      "face": "determined"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Poetry? On our last wall?",
      "face": "annoyed"
    },
    {
      "speaker": "JAMSHID",
      "text": "\"This world is a prison, and we are prisoners...\"",
      "face": "determined"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Cheerful.",
      "face": "annoyed"
    },
    {
      "speaker": "JAMSHID",
      "text": "\"Dig through the prison and—\"",
      "face": "determined"
    },
    {
      "speaker": "OFFICER",
      "text": "Hey! What are you doing?!",
      "face": "alarmed"
    },
    {
      "speaker": "OFFICER",
      "text": "Who painted this?",
      "face": "stern"
    },
    {
      "speaker": "JAMSHID",
      "text": "Me.",
      "face": "determined"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Jamshid—",
      "face": "surprised"
    },
    {
      "speaker": "JAMSHID",
      "text": "All of it.",
      "face": "determined"
    },
    {
      "speaker": "OFFICER",
      "text": "You're in serious trouble. Come with me.",
      "face": "angry"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Wait!",
      "face": "surprised"
    },
    {
      "speaker": "JAMSHID",
      "text": "Go home, cousin joon.",
      "face": "worried"
    },
    {
      "speaker": "HOOSHANG",
      "text": "How long will he be gone?",
      "face": "vulnerable"
    }
  ],
  "palace": [
    {
      "speaker": "HOOSHANG",
      "text": "Four keys.",
      "face": "surprised"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Of course there are four keys.",
      "face": "annoyed"
    }
  ],
  "cell": [
    {
      "speaker": "HOOSHANG",
      "text": "Cousin joon!",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "Took you long enough.",
      "face": "joyful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Come on. Let's go.",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "Where?",
      "face": "worried"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Home.",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "...Oh.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Your mother is going to kill us both.",
      "face": "annoyed"
    },
    {
      "speaker": "JAMSHID",
      "text": "Probably just you.",
      "face": "joyful"
    }
  ],
  "chase": [
    {
      "speaker": "HOOSHANG",
      "text": "Slow down!",
      "face": "annoyed"
    },
    {
      "speaker": "JAMSHID",
      "text": "You slow down. You got old.",
      "face": "joyful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "And whose fault is that?",
      "face": "annoyed"
    },
    {
      "speaker": "HOOSHANG",
      "text": "We never finished it.",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "No.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Let's finish it now. You always started. You start.",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "It isn't my line to finish anymore, cousin joon.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "What does that mean?",
      "face": "surprised"
    },
    {
      "speaker": "JAMSHID",
      "text": "They're waiting for me.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Who is? Jamshid, who's waiting?",
      "face": "vulnerable"
    }
  ],
  "carpet": [
    {
      "speaker": "HOOSHANG",
      "text": "There it is.",
      "face": "happy"
    },
    {
      "speaker": "JAMSHID",
      "text": "There it is.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Come on. We'll ride it back.",
      "face": "happy"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Move over.",
      "face": "happy"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Jamshid.",
      "face": "neutral"
    },
    {
      "speaker": "JAMSHID",
      "text": "You go home.",
      "face": "worried"
    },
    {
      "speaker": "HOOSHANG",
      "text": "What?",
      "face": "surprised"
    },
    {
      "speaker": "JAMSHID",
      "text": "Your mother said before dark.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "It's morning.",
      "face": "surprised"
    },
    {
      "speaker": "JAMSHID",
      "text": "Then you're very late.",
      "face": "joyful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Stop it.",
      "face": "annoyed"
    },
    {
      "speaker": "JAMSHID",
      "text": "Cousin joon—",
      "face": "worried"
    },
    {
      "speaker": "HOOSHANG",
      "text": "We're going home.",
      "face": "annoyed"
    },
    {
      "speaker": "JAMSHID",
      "text": "You are.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I found all four keys.",
      "face": "surprised"
    },
    {
      "speaker": "JAMSHID",
      "text": "I know.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "So get off the carpet.",
      "face": "annoyed"
    },
    {
      "speaker": "JAMSHID",
      "text": "I can't.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "What do you mean, you can't?",
      "face": "surprised"
    },
    {
      "speaker": "HOOSHANG",
      "text": "No. No, no. Jamshid, get off.",
      "face": "vulnerable"
    },
    {
      "speaker": "HOOSHANG",
      "text": "GET OFF!",
      "face": "annoyed"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I'm not letting go.",
      "face": "vulnerable"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I can fix it.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "You tried.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I CAN FIX IT!",
      "face": "annoyed"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Tell me what I missed. Tell me which key.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "Hooshang—",
      "face": "worried"
    },
    {
      "speaker": "HOOSHANG",
      "text": "There has to be another key. There's always another key.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "There were never any keys, cousin joon.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Don't.",
      "face": "sad"
    },
    {
      "speaker": "JAMSHID",
      "text": "Mine.",
      "face": "determined"
    },
    {
      "speaker": "JAMSHID",
      "text": "Go home, cousin joon.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I should have said they were mine.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "We both painted it.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I should have said something.",
      "face": "sad"
    },
    {
      "speaker": "JAMSHID",
      "text": "You were seventeen.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "So were you.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "You were supposed to come home.",
      "face": "sad"
    },
    {
      "speaker": "JAMSHID",
      "text": "I know.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I waited.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "I know.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Then I left.",
      "face": "sad"
    },
    {
      "speaker": "JAMSHID",
      "text": "I know.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I got old.",
      "face": "sad"
    },
    {
      "speaker": "JAMSHID",
      "text": "I noticed.",
      "face": "joyful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I wasted it. All that time.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "You're wasting it now.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "What?",
      "face": "surprised"
    },
    {
      "speaker": "JAMSHID",
      "text": "Look.",
      "face": "friendly"
    },
    {
      "speaker": "JAMSHID",
      "text": "Please let go.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "No.",
      "face": "sad"
    },
    {
      "speaker": "JAMSHID",
      "text": "Hooshang.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "If I let go, you leave.",
      "face": "vulnerable"
    },
    {
      "speaker": "JAMSHID",
      "text": "I already left.",
      "face": "sad"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I'm sorry.",
      "face": "sad"
    },
    {
      "speaker": "JAMSHID",
      "text": "I know.",
      "face": "friendly"
    }
  ],
  "fall": [
    {
      "speaker": "RUMI",
      "text": "Breathe, jaan.",
      "face": "sorrowful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I don't want to.",
      "face": "flat"
    },
    {
      "speaker": "RUMI",
      "text": "I know. Breathe anyway.",
      "face": "serene"
    }
  ],
  "bank": [
    {
      "speaker": "HOOSHANG",
      "text": "Where is he?",
      "face": "confused"
    },
    {
      "speaker": "RUMI",
      "text": "You know where he is.",
      "face": "sorrowful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Say it.",
      "face": "vulnerable"
    },
    {
      "speaker": "RUMI",
      "text": "No, jaan.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "SAY IT.",
      "face": "angry"
    },
    {
      "speaker": "RUMI",
      "text": "You have carried that answer for fifty years. You have just never set it down long enough to look at it.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Then why bring me here? So I could watch it happen again, and still not stop it?",
      "face": "vulnerable"
    },
    {
      "speaker": "RUMI",
      "text": "No. You could not stop it.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Then what was it FOR?",
      "face": "angry"
    },
    {
      "speaker": "RUMI",
      "text": "Not to change it, jaan. To see it.",
      "face": "serene"
    },
    {
      "speaker": "RUMI",
      "text": "You asked me where the seed came from. There it is. A boy's hand opened, a can fell, and he said nothing.",
      "face": "sorrowful"
    },
    {
      "speaker": "RUMI",
      "text": "And every night for fifty years, you watered it. Until it grew tall enough to wear your face.",
      "face": "sorrowful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "...Darkshang.",
      "face": "shocked"
    },
    {
      "speaker": "RUMI",
      "text": "Yes.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Then let it have me. He took my punishment, and I let him.",
      "face": "sad"
    },
    {
      "speaker": "RUMI",
      "text": "In fifty years of paying him back, did one single day of it open one single door?",
      "face": "sorrowful"
    },
    {
      "speaker": "RUMI",
      "text": "Guilt is a loyal dog, jaan. It follows you everywhere, and it fetches nothing.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I let go of him.",
      "face": "sad"
    },
    {
      "speaker": "RUMI",
      "text": "I saw.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "It felt like dropping him.",
      "face": "sad"
    },
    {
      "speaker": "RUMI",
      "text": "You did not drop him, jaan. He was never the one being held. You were.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "It'll come back. The shadow.",
      "face": "vulnerable"
    },
    {
      "speaker": "RUMI",
      "text": "Some nights, yes.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Then what do I do?",
      "face": "confused"
    },
    {
      "speaker": "RUMI",
      "text": "Don't fight it. Hold it, the way you would hold a frightened boy.",
      "face": "serene"
    },
    {
      "speaker": "RUMI",
      "text": "Because that is all it ever was.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "He used to fish right there.",
      "face": "sad"
    },
    {
      "speaker": "RUMI",
      "text": "Look at the water. Where did it come from?",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "...Rain, I suppose.",
      "face": "hesitant"
    },
    {
      "speaker": "RUMI",
      "text": "And the rain?",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "A cloud.",
      "face": "neutral"
    },
    {
      "speaker": "RUMI",
      "text": "Did the cloud die?",
      "face": "serene"
    },
    {
      "speaker": "RUMI",
      "text": "It became the rain, jaan. Look for him in what he became.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Where?",
      "face": "vulnerable"
    },
    {
      "speaker": "RUMI",
      "text": "Look at your hand.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "He never finished the line.",
      "face": "sad"
    },
    {
      "speaker": "RUMI",
      "text": "No. The whistle finished it for him.",
      "face": "sorrowful"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Then it doesn't get finished.",
      "face": "flat"
    },
    {
      "speaker": "RUMI",
      "text": "Does it not?",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Wait. Where are you going? Just say the rest. It's your poem. You're Rumi.",
      "face": "surprised"
    },
    {
      "speaker": "RUMI",
      "text": "You learned it in his voice, not mine. It is your line now.",
      "face": "warm_open"
    },
    {
      "speaker": "HOOSHANG",
      "text": "I don't know if I can.",
      "face": "hesitant"
    },
    {
      "speaker": "RUMI",
      "text": "You have already done the harder half.",
      "face": "serene"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Which half?",
      "face": "confused"
    },
    {
      "speaker": "RUMI",
      "text": "You opened your hand.",
      "face": "warm_open"
    }
  ],
  "second_line": [
    {
      "speaker": "JAMSHID",
      "text": "Keep going.",
      "face": "friendly"
    },
    {
      "speaker": "HOOSHANG",
      "text": "\"This world is a prison, and we are prisoners. Dig through the prison, and set yourself free.\"",
      "face": "neutral"
    },
    {
      "speaker": "HOOSHANG",
      "text": "Took me long enough.",
      "face": "happy"
    },
    {
      "speaker": "HOOSHANG",
      "text": "...I'm home.",
      "face": "happy"
    }
  ]
}
