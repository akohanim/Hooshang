; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hooshang"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Screen="*res://systems/screen.gd"
InputDevice="*res://systems/input_device.gd"
Dialogue="*res://scenes/ui/DialogueBox.tscn"
VoiceBlips="*res://systems/voice_blips.gd"
Game="*res://systems/game.gd"
Collectibles="*res://systems/collectibles.gd"
Deaths="*res://systems/deaths.gd"
Points="*res://systems/points.gd"
SaveGame="*res://systems/save_game.gd"
Pause="*res://scenes/ui/PauseMenu.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/ldtk-importer/plugin.cfg")

