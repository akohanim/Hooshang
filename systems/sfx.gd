extends Node
## The `Sfx` autoload: one-shot gameplay sounds (ElevenLabs Sound Effects v2,
## generated by tools/gen_elevenlabs_sfx.py, mastered by
## tools/master_elevenlabs_sfx.py — prompts in assets/audio/elevenlabs_v2/
## manifest.json). Callers name a CUE, never a file:
##
##   Sfx.play(&"jump")
##   Sfx.footstep(player)        # picks scaffold / stone / grass from the floor
##
## A cue with several variations never plays the same one twice in a row, and
## every play gets a little pitch jitter, so a run of footsteps or ladder rungs
## does not machine-gun one sample. A small pool of players lets sounds overlap
## (a landing over a footstep) without cutting each other off.
##
## Everything is on the Master bus like the game's existing cues; turning MUSIC
## off in the pause menu leaves these playing, as it does a dialogue blip.

const DIR := "res://assets/audio/elevenlabs_v2/"
## cue -> [variation count, volume_db, pitch jitter (+/- fraction)]
const CUES := {
	# Footsteps are texture, not information: scaffolding only, and quiet
	# enough to sit just under the music. Ladder rungs and strokes likewise.
	&"step_scaffold": [4, -25.0, 0.06],
	&"ladder": [4, -27.0, 0.06],
	&"swim": [3, -22.0, 0.08],
	&"jump": [1, -18.0, 0.08],
	&"land": [1, -15.0, 0.06],
	# Two short warm scuffs: they alternate like left and right kicks up a
	# chimney, and each is over in well under the time between two kicks.
	&"wall_jump": [2, -24.0, 0.06],
	&"splash": [1, -11.0, 0.05],
	# Muted like the footsteps: a hint under the music, not an alarm — the
	# blocks' own shake already says the floor is going.
	&"crumble_warn": [2, -32.0, 0.05],
	&"crumble_break": [3, -29.0, 0.06],
	# The deep "oom" sits mostly around 200 Hz, where the music is thickest,
	# so it runs hotter than its peak level suggests it needs to.
	&"death": [2, -3.0, 0.03],
	&"darkshang_gather": [1, -9.0, 0.0],
	&"darkshang_lunge": [1, -8.0, 0.0],
}
const POOL := 8

var _streams := {}
var _scaffold_tiles := {}
var _last := {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
## Off for headless tests that count what WOULD have played (see sfx_test).
var muted := false
## Every cue played since the last clear — tests read this, gameplay never does.
var history: Array[StringName] = []


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for cue: StringName in CUES:
		var count: int = CUES[cue][0]
		var list: Array[AudioStream] = []
		for k in count:
			var path := DIR + (("%s_%d.wav" % [cue, k + 1]) if count > 1 else "%s.wav" % cue)
			var stream := load(path) as AudioStream if ResourceLoader.exists(path) else null
			if stream != null:
				list.append(stream)
		_streams[cue] = list
	# Loaded as an imported JSON resource (as VoiceBlips loads its manifest):
	# raw FileAccess on res:// is not guaranteed to survive an export.
	var res := load(DIR + "surfaces.json") as JSON if ResourceLoader.exists(DIR + "surfaces.json") else null
	var surfaces = res.data if res != null else null
	if surfaces is Dictionary:
		for id in surfaces.get("scaffold_tiles", []):
			_scaffold_tiles[int(id)] = true
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = &"Master"
		add_child(p)
		_players.append(p)


## Play one variation of `cue`. `gain_db` is added to the cue's own level.
func play(cue: StringName, gain_db := 0.0) -> void:
	history.append(cue)
	var list: Array = _streams.get(cue, [])
	if muted or list.is_empty():
		return
	var index := randi() % list.size()
	if list.size() > 1 and index == _last.get(cue, -1):
		index = (index + 1) % list.size()
	_last[cue] = index
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	var spec: Array = CUES[cue]
	p.stream = list[index]
	p.volume_db = float(spec[1]) + gain_db
	p.pitch_scale = 1.0 + randf_range(-float(spec[2]), float(spec[2]))
	p.play()


## The footstep for whatever he is standing on — which is SILENCE except on
## scaffolding. Footsteps on brick, stone and grass were cut: a sound on every
## stride everywhere is noise, while the clank of a steel deck tells you
## something about where you are.
func footstep(player: Node2D, gain_db := 0.0) -> void:
	var cue := surface_cue(player)
	if cue != &"":
		play(cue, gain_db)


## Which footstep a floor makes, or &"" for none. Scaffolding is read off the
## actual tile under his feet: a cell's atlas x is its LDtk tile id, and
## tools/gen_footstep_surfaces.py lists the ids LDtk paints only on scaffolding
## (checked to be disjoint from every other terrain).
func surface_cue(player: Node2D) -> StringName:
	var world := player.get_parent()
	var room: Node2D = world.get("current_room") if world != null else null
	if room == null:
		return &""
	var layer := room.get_node_or_null("Collisions") as TileMapLayer
	if layer != null:
		var cell := layer.local_to_map(layer.to_local(player.global_position + Vector2(0, 8)))
		if layer.get_cell_source_id(cell) >= 0 and _scaffold_tiles.has(layer.get_cell_atlas_coords(cell).x):
			return &"step_scaffold"
	return &""
