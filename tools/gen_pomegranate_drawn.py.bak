#!/usr/bin/env python3
"""The pomegranate collectible, DRAWN rather than downscaled — 4 frames, 20x20.

The earlier version resampled the painted reference
(assets/props/pomegranate/source/pomegranate_hooshang.png) down to sprite size.
That is the wrong tool at this scale: there are 400 pixels to spend and a
resample spends them on averages — every aril becomes a fraction of a pixel of
red mixed into its neighbours, and the whole thing reads as a small photo rather
than as art. The world renders into a 320x180 buffer and nothing in it can be
denser than that, so the only route to a high-fidelity fruit is to make each of
those 400 pixels carry a decision.

So this places them. The reference still governs shape and colour — a cut
pomegranate seen face on, crown up, rind showing as a crescent bottom right —
but every aril is an individual pixel with its own highlight, the rind has a lit
edge and a shadowed one, and the palette is small and hard so nothing muddies.

The four frames are a SHIMMER, not a rotation: the specular travels around the
lit shoulder and different arils catch it. At 20px a rotation needs four
separately drawn poses and reads as a wobble; light moving over a still object
reads as a gem.

Re-run after editing: python3 tools/gen_pomegranate.py
"""
import os
from PIL import Image

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "assets", "props", "pomegranate")
SIZE = 20

# A small, hard palette. Deliberately few steps per material: the eye reads
# three well-separated tones as more solid than six blurry ones, and blurry
# steps are exactly what the downscale produced.
P = {
    "K": (44, 8, 20, 255),      # outline / deepest shadow
    "D": (104, 18, 38, 255),    # rind in shadow
    "R": (163, 30, 52, 255),    # rind mid
    "r": (204, 58, 74, 255),    # rind lit
    "H": (236, 122, 130, 255),  # rind rim light
    "S": (255, 226, 226, 255),  # specular
    "W": (247, 226, 202, 255),  # pith, lit
    "w": (214, 184, 158, 255),  # pith, shadowed
    "A": (122, 12, 30, 255),    # aril, shadowed side
    "a": (196, 24, 46, 255),    # aril body
    "b": (238, 74, 84, 255),    # aril lit
    "g": (255, 200, 205, 255),  # aril glint
    "C": (92, 60, 34, 255),     # crown, dark
    "c": (150, 106, 62, 255),   # crown, lit
}

# The fruit's body. Flattened slightly — a pomegranate is wider than tall and
# sits heavy; a true circle reads as an apple.
CX, CY, RX, RY = 9.5, 12.6, 8.6, 7.4
# The cut face, up and left of centre so the rind shows as a crescent bottom
# right. That crescent is the single strongest cue that the fruit is cut open.
FX, FY, FRX, FRY = 8.6, 11.9, 6.3, 5.4

# The seeds live in LOBES, not scattered across the face.
#
# Four passes to get here, and the lesson each time was the same one: at 20px
# legibility beats density. Hand-placed dots read as vertical stripes. A
# staggered lattice read as a picnic tablecloth. An irregular hash read as
# static — thirty individually correct seeds that add up to noise, because none
# of them is big enough to be seen as a seed.
#
# What a cut pomegranate actually reads as, at any size, is a pale face with
# dark red MASSES in it. So there are two, each a compact cluster with its own
# lit top and shadowed underside, and the pith between them is a shape rather
# than a gap. Texture inside a lobe comes from alternating values, which is
# enough to say "many small things" without trying to draw each one.
# Far enough apart to leave a pith wall between them. At 3.1 wide and 5.6 apart
# they overlapped at the centre and read as one horizontal red band — two lobes
# that touch are one lobe.
LOBES = [(6.0, 11.0, 2.6, 3.9), (12.6, 11.2, 2.5, 3.9)]
## Two loose seeds below, where they have spilled towards the cut. Two, not
## five: more and the pale floor of the face stops reading.
LOOSE = [(9, 15), (10, 16)]


# The crown: three spikes, the middle tallest, over a dark calyx.
CROWN = [
    (7, 3, "c"), (9, 2, "c"), (11, 3, "c"),
    (7, 4, "C"), (8, 4, "c"), (9, 3, "c"), (9, 4, "C"), (10, 4, "c"), (11, 4, "C"),
    (8, 5, "C"), (9, 5, "C"), (10, 5, "C"),
]

# Where the specular sits per frame — it travels around the lit shoulder. These
# are RIND pixels: the first set sat inside the cut face, so the shine was
# landing on the seeds where no light could reach it.
SHINE = [(3, 9), (4, 7), (6, 6), (4, 8)]


def inside(x, y, cx, cy, rx, ry, grow=0.0):
    dx = (x + 0.5 - cx) / (rx + grow)
    dy = (y + 0.5 - cy) / (ry + grow)
    return dx * dx + dy * dy <= 1.0


def draw(frame):
    px = {}

    def put(x, y, key):
        if 0 <= x < SIZE and 0 <= y < SIZE:
            px[(x, y)] = P[key]

    # --- the rind, shaded by where the light is (upper left) ---------------
    for y in range(SIZE):
        for x in range(SIZE):
            if not inside(x, y, CX, CY, RX, RY):
                continue
            t = ((x + 0.5 - CX) / RX * 0.72) + ((y + 0.5 - CY) / RY * 0.69)
            key = "H" if t < -0.62 else "r" if t < -0.12 else "R" if t < 0.42 else "D"
            put(x, y, key)

    # --- the cut face -------------------------------------------------------
    for y in range(SIZE):
        for x in range(SIZE):
            if not inside(x, y, FX, FY, FRX, FRY):
                continue
            low = (y + 0.5 - FY) / FRY + (x + 0.5 - FX) / FRX
            # A ring of shadow just inside the cut edge. This is what makes the
            # face read as RECESSED — without it the seeds look painted onto the
            # outside of the fruit rather than sitting in a hollow.
            if not inside(x, y, FX, FY, FRX - 1.15, FRY - 1.15):
                put(x, y, "A" if low > -0.2 else "w")
            else:
                put(x, y, "w" if low > 0.1 else "W")

    # --- the seeds ----------------------------------------------------------
    glint_at = frame % 4
    n = 0
    for (lx, ly, lrx, lry) in LOBES:
        for y in range(SIZE):
            for x in range(SIZE):
                if not inside(x, y, lx, ly, lrx, lry):
                    continue
                if not inside(x, y, FX, FY, FRX - 0.9, FRY - 0.9):
                    continue
                n += 1
                # Two things at once, and needing both is what took five passes.
                #
                # The LOBE is a rounded heap: lit across the top, shadowed
                # underneath, so it has a form. The SEEDS are the staggered
                # alternation inside it — every other cell drops to the darkest
                # red, which at this scale is not "a gap between seeds" so much
                # as the shadow you would see if there were one. Without the
                # heap it is a red patch; without the alternation it is a red
                # blob, and the downscaled version it replaces beat both,
                # because a blur at least had granularity.
                t = (y + 0.5 - ly) / lry
                gap = (x + (y % 2)) % 2 == 1
                if t > 0.55:
                    key = "A"
                elif gap:
                    key = "A" if t > 0.0 else "a"
                else:
                    key = "b" if t < -0.15 else "a"
                put(x, y, key)
                if key == "b" and n % 6 == glint_at:
                    put(x, y, "g")
    for (x, y) in LOOSE:
        if inside(x, y, FX, FY, FRX - 0.9, FRY - 0.9):
            put(x, y, "a")
            put(x, y - 1, "b")

    # --- crown --------------------------------------------------------------
    for (x, y, key) in CROWN:
        put(x, y, key)

    # --- weight along the shadowed edge, then the specular -------------------
    for y in range(SIZE):
        for x in range(SIZE):
            if (x, y) in px and not inside(x, y, CX, CY, RX, RY, -1.0):
                t = ((x + 0.5 - CX) / RX) + ((y + 0.5 - CY) / RY)
                if t > 0.75:
                    put(x, y, "K")
    sx, sy = SHINE[frame % len(SHINE)]
    for (px_, py_, key) in ((sx, sy, "S"), (sx + 1, sy, "S"), (sx, sy + 1, "H")):
        if inside(px_, py_, CX, CY, RX, RY) \
                and not inside(px_, py_, FX, FY, FRX, FRY):
            put(px_, py_, key)

    # --- outline ------------------------------------------------------------
    # One pixel of the darkest tone wherever the fruit meets nothing, so the
    # silhouette holds against a pale office wall and a near-black cave alike.
    edges = []
    for (x, y) in px:
        for (dx, dy) in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            if (x + dx, y + dy) not in px:
                edges.append((x + dx, y + dy))
    for (x, y) in edges:
        if 0 <= x < SIZE and 0 <= y < SIZE and (x, y) not in px:
            px[(x, y)] = P["K"]

    img = Image.new("RGBA", (SIZE, SIZE), (0, 0, 0, 0))
    for (x, y), colour in px.items():
        img.putpixel((x, y), colour)
    return img


os.makedirs(OUT, exist_ok=True)
for i in range(4):
    draw(i).save(os.path.join(OUT, "frame_%03d.png" % i))
print("drew 4 frames at %dx%d" % (SIZE, SIZE))
